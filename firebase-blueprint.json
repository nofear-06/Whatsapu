{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered user profile on WhatsApp platform",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "about": { "type": "string" },
        "isOnline": { "type": "boolean" },
        "lastSeen": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "displayName"]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "1-on-1 direct messaging conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "participantDetails": { "type": "object" },
        "lastMessage": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "participants"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Message entry within a chat thread",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "text": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "chatId", "senderId", "text"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile collection"
    },
    "/chats/{chatId}": {
      "schema": "ChatThread",
      "description": "Active chat conversations"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Messages inside a chat thread"
    }
  }
}
